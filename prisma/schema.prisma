generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String       @id @default(uuid())
  email                String       @unique
  password             String
  name                 String
  currentProjectId     String?
  currentProject       Project?     @relation("UserActiveProject", fields: [currentProjectId, id], references: [id, ownerId])
  weekStartDay         WeekStartDay @default(MONDAY)
  timezone             String       @default("UTC")
  dailyCapacityMinutes Int?
  todayRevision        Int          @default(0)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  tasks                Task[]
  projects             Project[]    @relation("ProjectOwner")
  todayMutationReceipts TodayMutationReceipt[]
}

model Project {
  id         String    @id @default(uuid())
  name       String
  archived   Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  owner          User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  ownerId        String
  activeForUsers User[]          @relation("UserActiveProject")
  tasks          Task[]
  dailyPlanItems DailyPlanItem[]
  workLogEntries WorkLogEntry[]
  loggedTime     WorkSession[]

  @@unique([id, ownerId])
  @@index([ownerId])
  @@index([ownerId, archived])
}

enum TaskStatus {
  READY
  IN_PROGRESS
  PAUSED
  RESUMED
  COMPLETED
  CANCELLED
}

enum WeekStartDay {
  SUNDAY
  MONDAY
  SATURDAY
}

enum DailyPlanOutcome {
  OPEN
  COMPLETED
  CANCELLED
  CARRIED
  RETURNED_TO_BACKLOG
}

enum WorkLogEntryKind {
  PROGRESS
  NOTE
  COMPLETION_SUMMARY
}

enum WorkSessionSource {
  TIMER
  MIGRATED
  MANUAL_CORRECTION
}

model Task {
  id                    String     @id @default(uuid())
  title                 String
  status                TaskStatus @default(READY)
  progress              String?
  todo                  String?
  currentNextStep       String?
  defaultPlannedMinutes Int?
  completedAt           DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  User         User            @relation(fields: [userId], references: [id])
  userId       String
  Project      Project         @relation(fields: [projectId, userId], references: [id, ownerId])
  projectId    String
  loggedTime   WorkSession[]
  dailyPlans   DailyPlanItem[]
  workLog      WorkLogEntry[]
  todayMutationReceipts TodayMutationReceipt[]
  totalSeconds Float           @default(0)

  @@unique([id, userId, projectId])
  @@index([userId])
  @@index([userId, updatedAt])
  @@index([userId, status])
  @@index([userId, projectId])
  @@index([projectId])
}

model WorkSession {
  id                String            @id @default(uuid())
  startedAt         DateTime          @map("from")
  endedAt           DateTime?         @map("to")
  userId            String
  projectId         String
  source            WorkSessionSource @default(TIMER)
  originalStartedAt DateTime?
  originalEndedAt   DateTime?
  correctionReason  String?
  correctedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  Task           Task           @relation(fields: [taskId, userId, projectId], references: [id, userId, projectId], map: "TaskTime_taskId_userId_projectId_fkey")
  taskId         String
  Project        Project        @relation(fields: [projectId, userId], references: [id, ownerId], map: "TaskTime_projectId_userId_fkey")
  workLogEntries WorkLogEntry[]

  @@unique([id, taskId, userId, projectId], map: "TaskTime_id_taskId_userId_projectId_key")
  @@unique([taskId], map: "TaskTime_one_open_per_task", where: { endedAt: null })
  @@unique([projectId], map: "TaskTime_one_open_per_project", where: { endedAt: null })
  @@index([taskId], map: "TaskTime_taskId_idx")
  @@index([taskId, startedAt], map: "TaskTime_taskId_from_idx")
  @@index([userId, startedAt], map: "TaskTime_userId_from_idx")
  @@index([projectId, startedAt], map: "TaskTime_projectId_from_idx")
  @@map("TaskTime")
}

model DailyPlanItem {
  id             String           @id @default(uuid())
  userId         String
  projectId      String
  taskId         String
  planDate       DateTime         @db.Date
  plannedMinutes Int?
  position       Int
  outcome        DailyPlanOutcome @default(OPEN)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  Task    Task    @relation(fields: [taskId, userId, projectId], references: [id, userId, projectId])
  Project Project @relation(fields: [projectId, userId], references: [id, ownerId])

  @@unique([userId, taskId, planDate])
  @@index([userId, planDate, position])
  @@index([projectId, planDate])
}

model WorkLogEntry {
  id               String           @id @default(uuid())
  userId           String
  projectId        String
  taskId           String
  sessionId        String?
  kind             WorkLogEntryKind @default(NOTE)
  content          String
  nextStepSnapshot String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  Task    Task         @relation(fields: [taskId, userId, projectId], references: [id, userId, projectId])
  Project Project      @relation(fields: [projectId, userId], references: [id, ownerId])
  session WorkSession? @relation(fields: [sessionId, taskId, userId, projectId], references: [id, taskId, userId, projectId], map: "WorkLogEntry_sessionId_taskId_userId_projectId_fkey")

  @@index([userId, createdAt])
  @@index([taskId, createdAt])
  @@index([sessionId])
}

model TodayMutationReceipt {
  id         String   @id @default(uuid())
  userId     String
  requestId  String
  kind       String
  payloadHash String
  taskId     String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([userId, requestId])
  @@index([userId])
  @@index([taskId])
}
